# Postgres connection string. When you add "Postgres" storage to this
# project from the Vercel dashboard (Storage tab → Postgres, powered by
# Neon), the right variable is injected automatically — you don't need to
# set this yourself on Vercel. For local development, copy the connection
# string Vercel gives you (or any Postgres/Neon URL) into .env.local.
DATABASE_URL=

# The access code the admin (father) types in at /login. Pick any PIN.
ADMIN_PIN=

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=
